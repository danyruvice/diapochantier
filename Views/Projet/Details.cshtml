@model DiaspoChantier.ViewModels.DetailProjetViewModel

@{
    ViewData["Title"] = Model.Titre;
}

@if (ViewData["MessageSucces"] is string messageSucces)
{
    <div class="alert alert-success">@messageSucces</div>
}

@if (ViewData["MessageErreur"] is string messageErreur)
{
    <div class="alert alert-danger">@messageErreur</div>
}

<section class="section-panel mb-4">
    <div class="section-header">
        <div>
            <p class="eyebrow">Projet</p>
            <h1 class="section-title mb-1">@Model.Titre</h1>
            <p class="section-copy mb-0">@Model.TypeProjet · @Model.Localisation · Créé le @Model.DateCreation.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="section-header-action">
            <span class="badge bg-primary-subtle text-primary-emphasis">@Model.Statut</span>
        </div>
    </div>

    <div class="project-stats-grid mt-3">
        <div>
            <p class="project-stat-label">Budget total</p>
            <strong>@Model.BudgetTotal.ToString("N0") FCFA</strong>
        </div>
        <div>
            <p class="project-stat-label">Latitude</p>
            <strong>@Model.Latitude.ToString("0.####")</strong>
        </div>
        <div>
            <p class="project-stat-label">Longitude</p>
            <strong>@Model.Longitude.ToString("0.####")</strong>
        </div>
        <div>
            <p class="project-stat-label">Entrepreneur assigné</p>
            <strong>@(string.IsNullOrWhiteSpace(Model.Entrepreneur) ? "En attente de sélection" : Model.Entrepreneur)</strong>
        </div>
    </div>
</section>

<section class="section-panel mb-4" id="photos">
    <div class="section-header mb-3">
        <div>
            <p class="eyebrow">Photos GPS</p>
            <h2 class="section-title mb-0">Capture photo authentifiée</h2>
            <p class="section-copy mb-0">Activez la caméra, récupérez la position GPS du chantier puis capturez une preuve. Le serveur vérifie le hash SHA-256 et la distance à moins de 200 m.</p>
        </div>
        <div class="section-header-action">
            <a class="btn btn-modern-secondary" asp-controller="Photo" asp-action="Galerie" asp-route-projetId="@Model.IdProjet">Voir la galerie</a>
        </div>
    </div>

    <form asp-controller="Photo" asp-action="Upload" method="post" enctype="multipart/form-data" class="photo-gps-form" data-photo-gps-form>
        @Html.AntiForgeryToken()

        <input type="hidden" name="projetId" value="@Model.IdProjet" />
        <input type="hidden" name="altitude" value="" data-altitude-input />
        <input type="hidden" name="hashSha256" value="" data-hash-input />
        <input type="hidden" name="horodatageGps" value="" data-horodatage-input />

        <div class="photo-gps-fields">
            <div>
                <label class="form-label" for="jalonId">Jalon concerné</label>
                <select id="jalonId" name="jalonId" class="form-control" required>
                    @foreach (var jalon in Model.Jalons.OrderBy(j => j.Ordre))
                    {
                        <option value="@jalon.IdJalon">Jalon @jalon.Ordre - @jalon.Titre</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Aperçu caméra</label>
                <video data-camera-preview autoplay playsinline muted class="photo-preview-video"></video>
                <canvas data-camera-canvas hidden></canvas>
                <div data-photo-preview class="photo-preview"></div>
            </div>
        </div>

        <div class="photo-gps-location-grid">
            <div>
                <label class="form-label" for="latitude">Latitude</label>
                <input id="latitude" name="latitude" type="text" class="form-control" placeholder="Cliquez sur localiser" readonly />
            </div>
            <div>
                <label class="form-label" for="longitude">Longitude</label>
                <input id="longitude" name="longitude" type="text" class="form-control" placeholder="Cliquez sur localiser" readonly />
            </div>
        </div>

        <div class="photo-gps-actions">
            <button type="button" class="btn btn-modern-secondary" data-start-camera>Activer la caméra</button>
            <button type="button" class="btn btn-modern-secondary" data-capture-photo disabled>Capturer la photo</button>
            <button type="button" class="btn btn-modern-primary" data-localiser-gps>Localiser la position</button>
            <button type="button" class="btn btn-primary" data-upload-photo>Vérifier et téléverser</button>
        </div>

        <p class="gps-status" data-gps-status>Activez la caméra, localisez la prise, puis capturez la photo.</p>
        <small class="text-muted">Le serveur recalcule le hash SHA-256 et refuse la photo si la capture ne correspond pas à la preuve envoyée.</small>
    </form>

    @if (Model.Photos.Count > 0)
    {
        <div class="photo-gps-gallery mt-3">
            @foreach (var photo in Model.Photos)
            {
                <article class="photo-gps-card">
                    <img src="@photo.Url" alt="Photo GPS du projet @Model.Titre" />
                    <div class="photo-gps-card-body">
                        <div class="photo-gps-badge @(photo.EstAuthentique ? "is-valid" : "is-warning")">@photo.StatutTexte</div>
                        <p class="section-copy mb-1"><strong>Jalon :</strong> @photo.JalonTitre</p>
                        <p class="section-copy mb-1"><strong>Horodatage :</strong> @photo.Horodatage</p>
                        <p class="section-copy mb-1"><strong>Distance :</strong> @photo.Distance</p>
                        <p class="section-copy mb-1"><strong>Coordonnées :</strong> @photo.Latitude, @photo.Longitude</p>
                        <p class="section-copy mb-0"><strong>Source :</strong> @photo.Source</p>
                        @if (!string.IsNullOrWhiteSpace(photo.HashSHA256))
                        {
                            <p class="section-copy mb-0"><strong>Hash :</strong> @photo.HashSHA256</p>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="section-panel" id="jalons">
    <div class="section-header mb-3">
        <div>
            <p class="eyebrow">Jalons</p>
            <h2 class="section-title mb-0">Suivi des jalons</h2>
        </div>
    </div>

    @if (Model.Jalons.Count == 0)
    {
        <div class="alert alert-success">Ce projet n’a pas encore de jalon associé. Ajoutez-en depuis le formulaire de création ou mettez à jour votre dossier.</div>
    }
    else
    {
        <div class="milestone-list">
            @foreach (var jalon in Model.Jalons.OrderBy(j => j.Ordre))
            {
                <article class="milestone-card">
                    <div class="milestone-card-header">
                        <div>
                            <p class="eyebrow mb-1">Jalon @jalon.Ordre</p>
                            <h3 class="mb-1">@jalon.Titre</h3>
                        </div>
                        <span class="badge bg-primary-subtle text-primary-emphasis">@(jalon.EstValide ? "Validé" : "En attente")</span>
                    </div>

                    <p class="section-copy mb-3">@((string.IsNullOrWhiteSpace(jalon.Description) ? "Aucune description détaillée renseignée." : jalon.Description))</p>

                    <div class="project-stats-grid">
                        <div>
                            <p class="project-stat-label">Montant</p>
                            <strong>@jalon.Montant.ToString("N0") FCFA</strong>
                        </div>
                        <div>
                            <p class="project-stat-label">Date limite</p>
                            <strong>@(jalon.DateLimite?.ToString("dd/MM/yyyy") ?? "Non définie")</strong>
                        </div>
                        <div>
                            <p class="project-stat-label">Validation</p>
                            <strong>@(jalon.DateValidation?.ToString("dd/MM/yyyy") ?? "À venir")</strong>
                        </div>
                    </div>

                    @if (jalon.Photos.Count > 0)
                    {
                        <div class="mt-3">
                            <h4 class="section-title mb-2">Preuves photo</h4>
                            <div class="photo-gps-gallery">
                                @foreach (var photo in jalon.Photos)
                                {
                                    <article class="photo-gps-card">
                                        <img src="@photo.Url" alt="Preuve photo pour @jalon.Titre" />
                                        <div class="photo-gps-card-body">
                                            <div class="photo-gps-badge @(photo.EstAuthentique ? "is-valid" : "is-warning")">@photo.StatutTexte</div>
                                            <p class="section-copy mb-1">@photo.Horodatage</p>
                                            <p class="section-copy mb-1">@photo.Distance</p>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (!jalon.EstValide && Model.PeutValiderJalons)
                    {
                        <div class="mt-3">
                            @if (jalon.PeutValider)
                            {
                                <form asp-controller="Projet" asp-action="ValiderJalon" asp-route-id="@jalon.IdJalon" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary">Valider le jalon</button>
                                </form>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Ajoutez une photo authentique pour pouvoir valider ce jalon.</p>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }

    <div class="mt-4">
        <a class="btn btn-modern-secondary" asp-controller="Projet" asp-action="Index">Retour à mes projets</a>
    </div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('[data-photo-gps-form]');
        if (!form) {
            return;
        }

        const latitudeInput = form.querySelector('[name="latitude"]');
        const longitudeInput = form.querySelector('[name="longitude"]');
        const status = form.querySelector('[data-gps-status]');
        const startCameraButton = form.querySelector('[data-start-camera]');
        const captureButton = form.querySelector('[data-capture-photo]');
        const uploadButton = form.querySelector('[data-upload-photo]');
        const localiserButton = form.querySelector('[data-localiser-gps]');
        const video = form.querySelector('[data-camera-preview]');
        const canvas = form.querySelector('[data-camera-canvas]');
        const preview = form.querySelector('[data-photo-preview]');
        const altitudeInput = form.querySelector('[data-altitude-input]');
        const hashInput = form.querySelector('[data-hash-input]');
        const horodatageInput = form.querySelector('[data-horodatage-input]');

        let stream = null;
        let capturedBlob = null;

        async function startCamera() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                status.textContent = 'La capture caméra n’est pas disponible sur ce navigateur.';
                return;
            }

            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } }, audio: false });
                video.srcObject = stream;
                await video.play();
                startCameraButton.textContent = 'Caméra active';
                startCameraButton.disabled = true;
                captureButton.disabled = false;
                status.textContent = 'Caméra activée. Vous pouvez maintenant capturer une photo.';
            }
            catch (error) {
                status.textContent = 'Impossible d’activer la caméra. Autorisez l’accès puis réessayez.';
            }
        }

        function stopCamera() {
            if (!stream) {
                return;
            }

            stream.getTracks().forEach(track => track.stop());
            stream = null;
            video.srcObject = null;
        }

        function updatePosition(position) {
            latitudeInput.value = position.coords.latitude.toFixed(6);
            longitudeInput.value = position.coords.longitude.toFixed(6);
            altitudeInput.value = position.coords.altitude ? position.coords.altitude.toFixed(2) : '';
            horodatageInput.value = new Date().toISOString();
            status.textContent = 'Position GPS capturée. Vous pouvez maintenant capturer la photo.';
        }

        function capturePhoto() {
            if (!video.videoWidth || !video.videoHeight) {
                status.textContent = 'Démarrez d’abord la caméra avant de capturer.';
                return;
            }

            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob(function (blob) {
                if (!blob) {
                    status.textContent = 'La photo n’a pas pu être générée.';
                    return;
                }

                capturedBlob = blob;
                const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
                preview.innerHTML = `<img src="${dataUrl}" alt="Aperçu de la photo capturée" />`;
                status.textContent = 'Photo capturée. Vient la vérification du hash et du téléversement.';
            }, 'image/jpeg', 0.92);
        }

        async function computeHash(blob) {
            const buffer = await blob.arrayBuffer();
            const digest = await crypto.subtle.digest('SHA-256', buffer);
            const hash = Array.from(new Uint8Array(digest)).map(value => value.toString(16).padStart(2, '0')).join('');
            hashInput.value = hash;
        }

        async function uploadPhoto() {
            if (!capturedBlob) {
                status.textContent = 'Capturez d’abord une photo avant de téléverser.';
                return;
            }

            if (!latitudeInput.value || !longitudeInput.value) {
                status.textContent = 'Récupérez d’abord la position GPS du chantier.';
                return;
            }

            await computeHash(capturedBlob);

            const formData = new FormData(form);
            formData.set('image', capturedBlob, 'capture.jpg');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            status.textContent = 'Vérification du fichier et téléversement en cours...';
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            });

            stopCamera();
            if (response.ok) {
                window.location.href = response.url;
                return;
            }

            status.textContent = 'Le téléversement a échoué. Réessayez ou vérifiez la connexion.';
        }

        startCameraButton.addEventListener('click', function () {
            startCamera();
        });

        captureButton.addEventListener('click', function () {
            capturePhoto();
        });

        localiserButton.addEventListener('click', function (event) {
            event.preventDefault();

            if (!navigator.geolocation) {
                status.textContent = 'La géolocalisation n’est pas disponible dans ce navigateur.';
                return;
            }

            localiserButton.disabled = true;
            localiserButton.textContent = 'Localisation en cours...';

            navigator.geolocation.getCurrentPosition(function (position) {
                updatePosition(position);
                localiserButton.textContent = 'Position capturée';
                localiserButton.disabled = false;
            }, function () {
                status.textContent = 'La récupération de la position GPS a échoué. Autorisez l’accès à la localisation ou réessayez.';
                localiserButton.textContent = 'Réessayer la localisation';
                localiserButton.disabled = false;
            }, { enableHighAccuracy: true, timeout: 10000 });
        });

        uploadButton.addEventListener('click', function (event) {
            event.preventDefault();
            uploadPhoto();
        });
    });
</script>
}

