@model List<DiaspoChantier.Models.InvitationProjet>

@{
    ViewData["Title"] = "Mes invitations";
}

<section class="section-panel">
    <div class="mb-4">
        <p class="eyebrow">Cycle de vie du projet</p>
        <h1 class="section-title mb-1">Mes invitations</h1>
        <p class="section-copy mb-0">Acceptez ou refusez les projets qui vous sont proposés pour faire évoluer votre portefeuille.</p>
    </div>

    @if (TempData["MessageSucces"] is string messageSucces)
    {
        <div class="alert alert-success mb-3">@messageSucces</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-success">Aucune invitation en attente pour le moment.</div>
    }
    else
    {
        <div class="project-list">
            @foreach (var invitation in Model)
            {
                <article class="project-card">
                    <div class="project-card-header">
                        <div>
                            <p class="eyebrow mb-1">Invitation @invitation.Statut</p>
                            <h2 class="section-title mb-1">@invitation.Projet?.Titre</h2>
                            <p class="section-copy mb-0">Envoyée le @invitation.DateCreation.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="dashboard-hero-actions">
                            <form asp-action="Repondre" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="invitationId" value="@invitation.IdInvitation" />
                                <input type="hidden" name="accepter" value="true" />
                                <button type="submit" class="btn btn-modern-primary">Accepter</button>
                            </form>
                            <form asp-action="Repondre" method="post" class="d-flex flex-column gap-2" style="min-width:220px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="invitationId" value="@invitation.IdInvitation" />
                                <input type="hidden" name="accepter" value="false" />
                                <input type="text" name="motifRefus" class="form-control form-control-sm" placeholder="Motif du refus (obligatoire)" required />
                                <button type="submit" class="btn btn-modern-secondary">Refuser</button>
                            </form>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="project-stat-label">Investisseur</p>
                        <strong>@(invitation.Projet?.Investisseur is null ? "À définir" : string.Join(" ", new[] { invitation.Projet.Investisseur.Prenom, invitation.Projet.Investisseur.Nom }.Where(x => !string.IsNullOrWhiteSpace(x))))</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(invitation.Message))
                    {
                        <div class="section-panel mt-3">
                            <h2 class="form-section-title">Message</h2>
                            <p class="section-copy mb-0">@invitation.Message</p>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>
