@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7">
        <div class="auth-shell">
            <span class="badge bg-primary-subtle text-primary-emphasis">Sécurité</span>
            <h1 class="h3 mt-3 mb-2">Définir un nouveau mot de passe</h1>
            <p class="text-muted mb-4">Saisissez votre nouveau mot de passe et confirmez-le pour terminer la réinitialisation.</p>

            <form asp-action="ReinitialisationMotDePasse" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NouveauMotDePasse" class="form-label"></label>
                    <input asp-for="NouveauMotDePasse" class="form-control" />
                    <span asp-validation-for="NouveauMotDePasse" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmerNouveauMotDePasse" class="form-label"></label>
                    <input asp-for="ConfirmerNouveauMotDePasse" class="form-control" />
                    <span asp-validation-for="ConfirmerNouveauMotDePasse" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Mettre à jour le mot de passe</button>
                </div>
            </form>

            <div class="mt-4">
                <a asp-action="Connexion">Retour à la connexion</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}