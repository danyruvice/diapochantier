<ul class="navbar-nav align-items-lg-center gap-lg-2">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-white-50">@User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-light btn-sm" asp-controller="Profil" asp-action="MonProfil">Mon profil</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-light btn-sm" asp-controller="Auth" asp-action="Deconnexion">Déconnexion</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-light btn-sm me-2" asp-controller="Auth" asp-action="Connexion">Connexion</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-light btn-sm" asp-controller="Auth" asp-action="ChoisirTypeCompte">Créer un compte</a>
        </li>
    }
</ul>
