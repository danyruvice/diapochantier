@model IEnumerable<VerificationDossierViewModel>
@{
    ViewData["Title"] = "Vérification des dossiers";
}

<div class="auth-shell">
    <span class="badge bg-primary-subtle text-primary-emphasis">Administration</span>
    <h1 class="h3 mt-3 mb-2">Dossiers en attente de vérification</h1>
    <p class="text-muted mb-4">Consultez les entrepreneurs à valider et ouvrez chaque dossier pour approuver ou rejeter la demande.</p>

    @if (TempData["MessageReussite"] is string messageSucces)
    {
        <div class="alert alert-success">@messageSucces</div>
    }

    @if (TempData["MessageErreur"] is string messageErreur)
    {
        <div class="alert alert-danger">@messageErreur</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-success">Aucun dossier n’est actuellement en attente de vérification.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Ville</th>
                        <th>Spécialité</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dossier in Model)
                    {
                        <tr>
                            <td>@dossier.NomComplet</td>
                            <td>@dossier.Email</td>
                            <td>@dossier.Ville</td>
                            <td>@dossier.Specialite</td>
                            <td>@dossier.StatutActuel</td>
                            <td>
                                <a class="btn btn-primary" asp-action="Details" asp-route-id="@dossier.IdEntrepreneur">Voir le dossier</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
